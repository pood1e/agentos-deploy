{% set execution_credentials = {
  'encryptionKeyFile': '/etc/kagent/execution/key',
  'oauth': {
    'tokenEndpoint': oidc_discovery.json.token_endpoint,
    'clientId': site_identity.clientId,
    'clientSecretFile': '/etc/kagent/identity/client-secret'
  }
} -%}
global:
  watchNamespaces: ["{{ agentos_namespace }}"]
providers: null
database:
  postgres:
    readWriteConnectionStringSecretRef: {name: kagent-postgres, key: connectionString}
    ownerConnectionStringSecretRef: {name: kagent-postgres, key: connectionString}
config:
  server:
    auth:
      mode: oidc
      oidc:
        issuer: {{ site_identity.issuer | to_json }}
        audience: {{ site_identity.audience | to_json }}
      serviceAccount: {authority: kubernetes}
  executionAuthorization:
{{ kagent_execution_authorization | combine(execution_credentials) | to_nice_yaml(indent=2) | indent(4, true) }}
  harnessImages:
    release: "{{ kagent_runtime_version }}"
    kagent: "{{ harness_defaults.standard.workload.image }}"
    claude: "{{ harness_defaults.claude.workload.image }}"
    codex: "{{ harness_defaults.codex.workload.image }}"
  database:
    owner: {role: kagent_owner}
    readWrite: {role: kagent_owner}
    vectorEnabled: true
  sandboxes:
    guestImage: ghcr.io/kagent-dev/kagent/sandbox-guest@sha256:5355072effb219e157c3e0471637ca64d1f84ab7513dde23968c20cd65d18c9b
    cpu: "1"
    memory: 1Gi
    defaultTtl: 3600s
    maxTtl: 86400s
  runtimeDefaults:
    telemetry: &telemetry
{{ {'captureContent': false, 'captureRawApiBodies': false} | combine(kagent_telemetry, recursive=true) | to_nice_yaml(indent=2) | indent(6, true) }}
    controlPlaneUrl: "http://kagent-controller.{{ agentos_namespace }}.svc.cluster.local:8083"
  telemetry: *telemetry
controller:
  podSecurityContext:
    runAsNonRoot: true
    fsGroup: 65532
    seccompProfile: {type: RuntimeDefault}
  volumes:
    - name: execution-credentials
      secret: {secretName: kagent-execution-credentials, defaultMode: 0440}
    - name: identity-client
      secret:
        secretName: {{ site_identity_secret | to_json }}
        defaultMode: 0440
        items: [{key: client-secret, path: client-secret}]
  volumeMounts:
    - {name: execution-credentials, mountPath: /etc/kagent/execution, readOnly: true}
    - {name: identity-client, mountPath: /etc/kagent/identity, readOnly: true}
  imagePullSecrets: [{name: agentos-registry}]
  substrateClientCertificate:
    enabled: true
substrateWorkerPool:
  create: true
  replicas: 3
  sandboxClass: microvm
  workerImage: "{{ substrate_microvm_image }}"
  serviceAccount: {create: false, name: kagent-workers}
  template:
    nodeSelector:
      ate.dev/substrate-version: "v{{ substrate_version }}"
    resources:
      requests:
        cpu: 500m
        memory: 4Gi
      limits:
        cpu: "4"
        memory: 4Gi
ui:
  enabled: false
kmcp:
  enabled: false
kagent-tools:
  enabled: false
grafana-mcp:
  enabled: false
